
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN 
  VENDOR
  RIDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}


enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  password        String
  phone           String?     @unique
  role            Role        @default(CUSTOMER)
  refreshToken    String?     @db.Text 
  emailVerified   Boolean     @default(false)
  isActive        Boolean     @default(false)     
  isPending       Boolean     @default(true)  
  otpToken        String?     @db.VarChar(10)
  otpExpiresAt    DateTime?
  apikey          String?
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  restaurant      Restaurant? @relation("VendorRestaurant")
  deliveries      Delivery[]  @relation("RiderDeliveries")
  cartItems       CartItem[]  

  wallet          Wallet?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("users")
  @@index([email])
  @@index([phone])
  @@index([role])
}



// ADDRESS

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  city      String
  street    String
  latitude  Float?
  longitude Float?
  orders    Order[]
  createdAt DateTime @default(now())

  @@map("addresses")
  @@index([userId])
}

// CART ITEM MODEL

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "userId_productId")
  @@map("cart_items")
  @@index([userId])
  @@index([productId])
}


// RESTAURANT

model Restaurant {
  id             String               @id @default(uuid())
  vendorId       String               @unique
  vendor         User                 @relation("VendorRestaurant", fields: [vendorId], references: [id])
  name           String
  description    String?
  rating         Float                @default(0)
  city           String?
  phone          String?
  isActive       Boolean              @default(true)
  averageRating  Float?
  schedules      RestaurantSchedule[]
  closures       RestaurantClosure[]
  menuCategories MenuCategory[]
  products       Product[]
  orders         Order[]
  reviews        Review[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("restaurants")
  @@index([vendorId])
  @@index([city])
  @@index([isActive])
}

model RestaurantSchedule {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  opensAt      String
  closesAt     String
  isClosed     Boolean    @default(false)

  @@unique([restaurantId, dayOfWeek])
  @@map("restaurant_schedules")
  @@index([restaurantId])
}

model RestaurantClosure {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  createdAt    DateTime   @default(now())

  @@map("restaurant_closures")
  @@index([restaurantId])
  @@index([startDate])
}

model MenuCategory {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())

  @@map("menu_categories")
  @@index([restaurantId])
  @@index([position])
}


// PRODUCT

model Product {
  id              String       @id @default(uuid())
  restaurantId    String
  menuCategoryId  String?
  name            String       @db.VarChar(255)
  description     String?      @db.Text

  price           Decimal      @db.Decimal(10, 2)
  originalPrice   Decimal?

  price           Float
  originalPrice   Float?

  discountPercent Float?
  discountExpiry  DateTime?
  image           String?      @db.VarChar(500)
  images          Json?
  isActive        Boolean      @default(true)
  isAvailable     Boolean      @default(true)
  stockQuantity   Int          @default(9999)
  prepTimeMinutes Int          @default(15)
  position        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory   MenuCategory? @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@map("products")
  @@index([restaurantId])
  @@index([menuCategoryId])
  @@index([isActive, isAvailable])
  @@index([position])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  restaurantId String
  addressId    String
  status       OrderStatus @default(PENDING)

  totalAmount  Decimal     @db.Decimal(10, 2)

  totalAmount  Float

  orderItems   OrderItem[]
  payment      Payment?
  delivery     Delivery?
  user         User        @relation(fields: [userId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  address      Address     @relation(fields: [addressId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
  @@index([userId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  reference String?
  createdAt DateTime      @default(now())

  @@map("payments")
  @@index([orderId])
  @@index([status])
}

model Delivery {
  id          String   @id @default(uuid())
  orderId     String   @unique
  riderId     String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider       User?    @relation("RiderDeliveries", fields: [riderId], references: [id])
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  @@map("deliveries")
  @@index([orderId])
  @@index([riderId])
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("reviews")
  @@index([userId])
  @@index([restaurantId])
  @@index([createdAt])

}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Decimal  @db.Decimal(10, 2) @default(0.00)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@map("wallets")
  @@index([userId])


}

model Transaction {
  id             String      @id @default(uuid())
  walletId       String
  amount         Decimal     @db.Decimal(10, 2)
  type           TransactionType
  status         PaymentStatus
  orderId        String?
  paymentId      String?
  description    String?
  runningBalance Decimal?    @db.Decimal(10, 2)
  metadata       Json?
  createdAt      DateTime    @default(now())

  wallet         Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
  @@index([walletId])
  @@index([walletId, createdAt(sort: Desc)])
}